{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!node_modules", "!coverage", "!dist", "!*.tgz"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "includes": [
      "**",
      "!.agents/prototypes/**",
      "!.engram/**",
      "!extensions/action-authorization.ts",
      "!tools/contextual-authorization-evaluation/cases.json",
      "!.impeccable/**",
      "!docs/specs/**",
      "!prototype/**"
    ]
  },
  "json": {
    "formatter": {
      "indentStyle": "space"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
